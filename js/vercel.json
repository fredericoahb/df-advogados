{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "routes": [
    { "src": "/assets/(.*)", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "src": "/css/(.*)", "headers": { "Cache-Control": "public, max-age=86400" } },
    { "src": "/js/(.*)", "headers": { "Cache-Control": "public, max-age=86400" } }
  ]
}